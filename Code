    const AIRPORTS = {
      "MRPV": { lat: 9.9572, lon: -84.1383 },
      "KMIA": { lat: 25.7959, lon: -80.2870 }
    };

    function toRad(deg) { return deg * Math.PI / 180; }

    function calcDistance(lat1, lon1, lat2, lon2) {
      const R = 3440.065;
      const dLat = toRad(lat2 - lat1);
      const dLon = toRad(lon2 - lon1);
      const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) *
                Math.sin(dLon/2) * Math.sin(dLon/2);
      return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    }

    async function calculateFlight() {
      const depCode = document.getElementById('dep').value.trim().toUpperCase();
      const arrCode = document.getElementById('arr').value.trim().toUpperCase();
      const acType = document.getElementById('aircraft').value;
      const acSpec = AIRCRAFT_DB[acType] || AIRCRAFT_DB['B752'];

      let tow = parseFloat(document.getElementById('tow').value) || 0;
      if (tow === 0) tow = acSpec.mtow;

      let ci = parseFloat(document.getElementById('ci').value) || 0;
      let cruiseAlt = parseFloat(document.getElementById('alt').value) || 0;
      if (cruiseAlt === 0) cruiseAlt = Math.min(37000, acSpec.ceiling);

      document.getElementById('loading').style.display = 'block';

      const depCoords = AIRPORTS[depCode] || { lat: 9.9572, lon: -84.1383 };
      const arrCoords = AIRPORTS[arrCode] || { lat: 25.7959, lon: -80.2870 };
      const distance = calcDistance(depCoords.lat, depCoords.lon, arrCoords.lat, arrCoords.lon);

      let windSpeed = 25; 
      let windDir = 270;
      try {
        const midLat = (depCoords.lat + arrCoords.lat) / 2;
        const midLon = (depCoords.lon + arrCoords.lon) / 2;
        const windUrl = `https://api.open-meteo.com/v1/forecast?latitude=${midLat}&longitude=${midLon}&current=wind_speed_250hpa,wind_direction_250hpa&wind_speed_unit=kn`;
        const resp = await fetch(windUrl);
        const data = await resp.json();
        if (data.current) {
          windSpeed = Math.round(data.current.wind_speed_250hpa || 25);
          windDir = Math.round(data.current.wind_direction_250hpa || 270);
        }
      } catch (e) {
        console.warn("Using fallback wind model:", e);
      }

      document.getElementById('loading').style.display = 'none';

      let tas = acSpec.tas + (ci * 0.15);
      const headwind = windSpeed * Math.cos(toRad(windDir - 15));
      const groundspeed = Math.max(100, tas - headwind);

      const cruiseHours = distance / groundspeed;
      const totalHours = cruiseHours + 0.35;
      const hours = Math.floor(totalHours);
      const mins = Math.round((totalHours - hours) * 60);

      const totalFuelBurn = Math.round(totalHours * acSpec.fuelBurn * (0.9 + (tow / acSpec.mtow) * 0.2));
      const estLw = tow - totalFuelBurn;

      document.getElementById('resDistance').innerText = `${Math.round(distance)} NM`;
      document.getElementById('resEte').innerText = `${hours}h ${mins}m`;
      document.getElementById('resGs').innerText = `${Math.round(groundspeed)} kts`;
      document.getElementById('resWind').innerText = `${windDir}° / ${windSpeed} kts`;
      document.getElementById('resFuel').innerText = `${totalFuelBurn.toLocaleString()} kg`;
      document.getElementById('resAltitude').innerText = `FL${Math.round(cruiseAlt / 100)}`;

      const weightRatio = tow / acSpec.mtow;
      const v1 = Math.round(110 + weightRatio * 35);
      const vr = Math.round(v1 + 5);
      const v2 = Math.round(vr + 8);

      let thrustText = "TOGA";
      if (acSpec.flexCapable && weightRatio < 0.92) {
        const flexTemp = Math.round(58 - (weightRatio * 15));
        thrustText = `FLEX +${flexTemp}°C`;
      }

      document.getElementById('resVspeeds').innerText = `${v1} / ${vr} / ${v2}`;
      document.getElementById('resToFlaps').innerText = acSpec.tas > 300 ? "1 / 1+F / 15°" : "10° / UP";
      document.getElementById('resThrust').innerText = thrustText;
      document.getElementById('resTrim').innerText = `${(4.2 + weightRatio * 1.5).toFixed(1)} UP`;

      const vref = Math.round(115 + (estLw / acSpec.mlw) * 25);
      const vapp = vref + 5;

      document.getElementById('resLw').innerText = `${estLw.toLocaleString()} kg`;

      const mlwBox = document.getElementById('resMlwStatus');
      if (estLw > acSpec.mlw) {
        mlwBox.innerText = "OVERWEIGHT";
        mlwBox.className = "stat-value status-overweight";
      } else {
        mlwBox.innerText = "NORMAL";
        mlwBox.className = "stat-value status-normal";
      }

      document.getElementById('resLdgSpeeds').innerText = `${vref} / ${vapp} kts`;
      document.getElementById('resLdgConfig').innerText = acSpec.tas > 300 ? "FULL / MED" : "FULL / LOW";
    }

    window.onload = calculateFlight;
  </script>
